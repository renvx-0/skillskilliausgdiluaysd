 "phrases": [
  {
   "text": "Si alguien abre otro grifo,",
   "s": 0.0,
   "e": 1.242
  },
  {
   "text": "esta ducha intenta evitar un cambio brusco de temperatura.",
   "s": 1.521,
   "e": 4.133
  },
  {
   "text": "Al principio,",
   "s": 4.624,
   "e": 5.26
  },
  {
   "text": "mezclamos agua fr\u00eda y caliente.",
   "s": 5.463,
   "e": 6.998
  },
  {
   "text": "Pero si cambia el suministro,",
   "s": 7.53,
   "e": 8.64
  },
  {
   "text": "la mezcla puede calentarse demasiado.",
   "s": 8.934,
   "e": 10.585
  },
  {
   "text": "Entonces entra en acci\u00f3n una c\u00e1psula con cera.",
   "s": 11.177,
   "e": 13.578
  },
  {
   "text": "Cuando el agua se calienta,",
   "s": 14.164,
   "e": 15.183
  },
  {
   "text": "la cera se expande y empuja una v\u00e1lvula.",
   "s": 15.451,
   "e": 17.362
  },
  {
   "text": "Esta reduce el paso de agua caliente y ajusta la mezcla.",
   "s": 17.908,
   "e": 20.715
  },
  {
   "text": "\u00bfY si el agua se enfr\u00eda?",
   "s": 21.359,
   "e": 22.328
  },
  {
   "text": "La cera se contrae y la v\u00e1lvula se mueve en sentido contrario.",
   "s": 23.039,
   "e": 26.045
  },
  {
   "text": "Sin electricidad y sin tocar el mando:",
   "s": 26.641,
   "e": 28.344
  },
  {
   "text": "\u00a1pum!",
   "s": 28.732,
   "e": 28.887
  },
  {
   "text": "La ducha recupera la temperatura elegida.",
   "s": 29.184,
   "e": 30.697
  }
 ]
